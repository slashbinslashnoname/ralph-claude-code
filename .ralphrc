# Ralph configuration — generated by Ralph Desktop
# Project: slashbot (nodejs)

# API / rate limiting
MAX_CALLS_PER_HOUR=100
CLAUDE_TIMEOUT_MINUTES=15

# Output and model
CLAUDE_OUTPUT_FORMAT=json
CLAUDE_CODE_CMD=claude

# Tool permissions
CLAUDE_ALLOWED_TOOLS="Write,Read,Edit,Bash(git add *),Bash(git commit *),Bash(git status),Bash(git diff),Bash(git log),Bash(npm *)"

# Loop timing
SLEEP_DURATION=3

# Circuit breaker
CB_NO_PROGRESS_THRESHOLD=3
CB_SAME_ERROR_THRESHOLD=5
CB_PERMISSION_DENIAL_THRESHOLD=2
CB_COOLDOWN_MINUTES=30

# Task sources: local, beads
TASK_SOURCES="local"
