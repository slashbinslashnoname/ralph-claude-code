{
  "name": "slashbot",
  "version": "1.0.0",
  "description": "Slashbot — Agent Flywheel Orchestrator for autonomous AI development with beads",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/frankbria/ralph-claude-code.git"
  },
  "keywords": ["electron", "ai", "claude", "beads", "autonomous"],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/frankbria/ralph-claude-code/issues"
  },
  "homepage": "https://github.com/frankbria/ralph-claude-code#readme",
  "dependencies": {
    "chokidar": "^3.6.0",
    "dagre": "^0.8.5",
    "node-pty": "^1.0.0",
    "telegraf": "^4.16.0"
  },
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@electron/rebuild": "^3.6.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.0",
    "vitest": "^3.1.1"
  }
